    {
      "url": "https://www.tce.mg.gov.br/TCEMG-emite-parecer-previo-pela-aprovacao-com-ressalvas-das-contas-de-2020-do-governador.html/Noticia/1111626070",
      "retrieved_at": "2026-10-16T17:55:57.604041+00:00",
